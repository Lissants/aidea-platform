# AIdea production settings, for the FIRST run of deploy-production.ps1:
#   deploy-production.cmd -Package <zip> -EnvFile <this file, filled in>
# The script copies it to C:\inetpub\aidea\.env.production.local (readable by
# administrators and the app pool only) and checks it on every deployment.
# Edit that copy afterwards, then run: Restart-WebAppPool AIdea
# See IIS_DEPLOYMENT.md for what to ask IT for.

# Must equal the -AppUrl the package was built with (no trailing slash).
NEXT_PUBLIC_APP_URL=https://aidea.godrejindonesia.com

# --- SQL Server --------------------------------------------------------------
# Use the SQL Server's FQDN, matching its certificate (TLS is validated).
MSSQL_SERVER=sql01.corp.example.com
MSSQL_DATABASE=aidea
# Leave empty to connect as the server's computer account (Windows auth); the
# deployment prints the T-SQL a DBA runs once to grant it access. Or use a SQL
# login with db_datareader, db_datawriter and EXECUTE only:
MSSQL_USER=
MSSQL_PASSWORD=

# --- Sessions ----------------------------------------------------------------
# Leave empty: the first deployment generates a random one. Must NOT be the
# development value. Changing it signs everyone out.
SESSION_SECRET=

# --- Active Directory sign-in (the only way in) ------------------------------
# Two or more domain controllers, ldaps:// only, host names as on their certificates.
LDAP_URL=ldaps://dc01.corp.example.com:636,ldaps://dc02.corp.example.com:636
LDAP_DOMAIN=
LDAP_CA_CERT_PATH=C:\aidea\certs\corp-root-ca.pem
# LDAP_BASE_DN=
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
ALLOWED_EMAIL_DOMAIN=godrejcp.com
AD_DEVELOPER_EMAILS=christopher.gerard@godrejcp.com
AD_ADMIN_EMAILS=setyarini@godrejcp.com,pahru.rozi@godrejcp.com,fitri.damayanti@godrejcp.com

# --- Files and email ---------------------------------------------------------
# On a BitLocker volume, included in backups. Default: C:\aidea\uploads
UPLOAD_DIR=D:\aidea\uploads
EMAIL_PROVIDER=smtp
EMAIL_FROM=aidea-noreply@godrejcp.com
# For the hourly voting notifications task. Leave empty: the first deployment
# generates one.
CRON_SECRET=
