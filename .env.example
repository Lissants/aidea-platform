# ---------------------------------------------------------------------------
# AIdea Submission Platform — environment variables
# Only vars prefixed NEXT_PUBLIC_ are sent to the browser bundle. Everything
# else stays server-only.
# ---------------------------------------------------------------------------

# App URL — used for the Microsoft SSO redirect URI and email links.
# localhost: http://localhost:3000
# Company server (production): https://aidea.godrejindonesia.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Dev server only (npm run dev): extra origins allowed to open it besides
# localhost. This machine's own IPv4 addresses are allowed automatically, so
# usually leave this empty. Use it for a DNS name, an address the PC doesn't
# own (VM/NAT), or a wildcard. Comma-separated, e.g.
# DEV_ALLOWED_ORIGINS=aidea-pc.corp.local,192.168.48.*
DEV_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# SQL Server (see LOCAL_SETUP.md)
# ---------------------------------------------------------------------------
# Driver: "msnodesqlv8" (Windows default) uses ODBC Driver 18 + Windows
# Integrated auth over shared memory — works against a default local
# SQL Server install with no TCP or SQL-login setup.
# "tedious" (Linux/Docker default) uses TCP 1433 + a SQL login.
MSSQL_DRIVER=msnodesqlv8
MSSQL_SERVER=.
MSSQL_DATABASE=aidea
# tedious only (or msnodesqlv8 with a SQL login instead of Windows auth):
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
# true = accept the server's certificate without validating it. Defaults to
# true for local development and FALSE in production (encryption requirement):
# give SQL Server a certificate for its FQDN from the corporate CA, trust that
# CA on the app server, and set MSSQL_SERVER to the FQDN.
# MSSQL_TRUST_CERT=
# Optional: full ODBC connection string, overrides the msnodesqlv8 fields above.
# MSSQL_CONNECTION_STRING=
# MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Signs the aidea_session cookie (HS256). REQUIRED in production, at least
# 32 random characters — e.g. `node -e "console.log(crypto.randomBytes(48).toString('base64url'))"`.
# Rotating it signs everyone out.
SESSION_SECRET=
# Set to false only for a plain-HTTP intranet deployment (defaults to true in production).
# SESSION_COOKIE_SECURE=

# ---------------------------------------------------------------------------
# Active Directory sign-in over LDAPS — the ONLY way into a production build.
# Users type their email or network ID and their Windows password; AIdea takes
# their name, department and title from AD at every sign-in. Without LDAP_URL
# nobody can sign in (under `npm run dev` it falls back to this PC's domain
# controller). Production refuses ldap://.
# ---------------------------------------------------------------------------
# One or more domain controllers, tried in order (comma-separated).
LDAP_URL=
# e.g. ldaps://dc01.corp.godrej.com:636,ldaps://dc02.corp.godrej.com:636
# Optional: read from the domain controller (defaultNamingContext) when empty.
LDAP_BASE_DN=
# NetBIOS domain for logins typed as a bare network ID (jdoe -> CORP\jdoe).
# When empty, a bare ID binds as jdoe@<DNS domain of the base DN>.
LDAP_DOMAIN=
# Optional read-only service account from IT. Without it AIdea signs in to AD
# as the user and reads their own record; with it, users are looked up first.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Corporate root CA (PEM) that issued the domain controllers' certificates.
LDAP_CA_CERT_PATH=
# Attributes a login is matched against (default below).
# LDAP_LOGIN_ATTRIBUTES=mail,userPrincipalName,sAMAccountName
# LDAP_TIMEOUT_MS=5000

# Roles. Everyone starts as User at first sign-in; admins promote people in
# User Management. These emails are put on their tier at every sign-in and
# can't be changed in the app (comma- or semicolon-separated).
AD_DEVELOPER_EMAILS=christopher.gerard@godrejcp.com
AD_ADMIN_EMAILS=setyarini@godrejcp.com,pahru.rozi@godrejcp.com,fitri.damayanti@godrejcp.com

# ---------------------------------------------------------------------------
# Microsoft Entra ID single sign-on (optional; the "Sign in with Microsoft"
# button only appears when all three are set, and in production also
# NEXT_PUBLIC_APP_URL). App registration (Web platform):
#   redirect URI:              {NEXT_PUBLIC_APP_URL}/auth/callback/microsoft
#   front-channel logout URL:  {NEXT_PUBLIC_APP_URL}/sign-in
# Client secrets expire; note the expiry date and rotate before it.
# Godrej tenant (godrejcp.com and godrejinds.com share it):
#   MICROSOFT_TENANT_ID=bfa3dfb0-91d5-4bf7-9a0c-fbf6ff337187
# ---------------------------------------------------------------------------
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Set to false to hide and refuse email + password sign-in once Microsoft
# sign-in works for everyone. Ignored while SSO is not configured. Keep it on
# while you still need a password-only break-glass admin.
# PASSWORD_SIGNIN_ENABLED=true

# Restrict sign-in (password and SSO) to company email domains
# (comma-separated). Leave empty only for local development.
ALLOWED_EMAIL_DOMAIN=godrejcp.com

# ---------------------------------------------------------------------------
# File uploads (program resources) — stored on local disk.
# Must be persistent storage (a Docker volume on the company server) and
# included in backups alongside the database.
# ---------------------------------------------------------------------------
UPLOAD_DIR=./uploads

# Email provider for the email_outbox notification system.
EMAIL_PROVIDER=smtp
EMAIL_FROM=aidea-noreply@godrejcp.com

# Shared secret for scheduled/cron route handlers (voting notifications).
# Required wherever cron is configured; not required for plain localhost dev.
CRON_SECRET=

# Password for the seeded demo accounts (npm run db:seed). Dev only.
# DEMO_PASSWORD=
