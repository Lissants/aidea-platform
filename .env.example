# ---------------------------------------------------------------------------
# AIdea Submission Platform — environment variables
# Only vars prefixed NEXT_PUBLIC_ are sent to the browser bundle. Everything
# else stays server-only. Never put SUPABASE_SERVICE_ROLE_KEY behind
# NEXT_PUBLIC_ — it bypasses RLS entirely.
# ---------------------------------------------------------------------------

# App URL — used for auth redirects, email links.
# localhost: http://localhost:3000
# Vercel: https://<your-vercel-domain>
# Company server: https://aidea.<company-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project — required everywhere (localhost, Vercel, company server).
# Found in Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key — SERVER ONLY. Used by lib/supabase/admin.ts and
# scripts/seed.ts to bypass RLS for privileged operations. Never expose to
# the browser. Required on all environments that run server actions needing
# elevated access (seeding, admin publish actions).
SUPABASE_SERVICE_ROLE_KEY=

# Email provider (magic link relies on Supabase Auth email; this is for the
# email_outbox notification/digest system in later phases).
EMAIL_PROVIDER=smtp
EMAIL_FROM=aidea-noreply@godrejcp.com

# Microsoft/Azure AD — only needed if SSO via Microsoft is enabled on
# company server / Vercel deployments tied to corporate identity. Not
# required for localhost email/password or magic-link dev flows.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Restrict sign-ups/sign-ins to a company email domain. Required on all
# environments to prevent external sign-up via magic link.
ALLOWED_EMAIL_DOMAIN=godrejcp.com

# Shared secret for scheduled/cron route handlers (e.g. auto-close voting
# periods, digest emails). Required on Vercel/company server wherever cron
# is configured; not required for plain localhost dev.
CRON_SECRET=
